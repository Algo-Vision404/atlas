FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements/pyproject
COPY pyproject.toml .
# We need to install the project in editable mode or just install dependencies
# For a container, we'll install dependencies first
RUN pip install --no-cache-dir .

# Copy source code
COPY apps/ apps/
COPY libs/ libs/
COPY services/ services/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Expose API port
EXPOSE 8000

# Command to run the API
CMD ["python", "apps/search_api/main.py"]
