# ATLAS Configuration

KAFKA_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://atlas:password@localhost:5432/atlas

OPENSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

DEFAULT_USER_AGENT=AtlasBot/0.2.0 (+https://atlas-engine.io)
CONCURRENT_REQUESTS_PER_DOMAIN=5
REQUEST_TIMEOUT=30
POLITENESS_DELAY=0.5
MAX_RETRIES=3
MAX_RESPONSE_BYTES=10000000
MAX_CRAWL_DEPTH=3
MAX_REDIRECTS=5
RESPECT_ROBOTS_TXT=true
ROBOTS_CACHE_TTL=3600
WORKER_LEASE_TTL=120
# Seconds before an already-crawled URL becomes eligible for a recrawl (0 = never)
RECRAWL_INTERVAL=86400

INDEXER_MAX_ATTEMPTS=3
INDEXER_RETRY_BACKOFF=2.0

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

SEARCH_API_HOST=0.0.0.0
SEARCH_API_PORT=8000
SEARCH_API_URL=http://localhost:8000
CRAWLER_API_HOST=0.0.0.0
CRAWLER_API_PORT=8001
CRAWLER_API_URL=http://localhost:8001

ATLAS_THEME=cyberpunk
LOG_LEVEL=INFO
MOCK_MODE=false
